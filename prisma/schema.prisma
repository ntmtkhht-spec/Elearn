generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  userLevel            String   @default("B1")
  hasCompletedPlacement Boolean @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model VocabDeck {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  description String?
  level       String   @default("B1")
  category    String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cards       VocabCard[]
}

model VocabCard {
  id                 String   @id @default(cuid())
  deckId             String
  word               String
  translation        String
  pronunciation      String?
  partOfSpeech       String?
  exampleSentence    String?
  exampleTranslation String?
  difficulty         Int      @default(1)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deck               VocabDeck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress           VocabProgress[]
}

model VocabProgress {
  id             String   @id @default(cuid())
  userId         String?
  cardId         String
  correctness    Int      @default(0)
  attempts       Int      @default(0)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime @default(now())
  interval       Int      @default(1)
  easeFactor     Float    @default(2.5)
  status         String   @default("new")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  card           VocabCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model ReadingExercise {
  id              String   @id @default(cuid())
  title           String
  content         String
  level           String   @default("B1")
  category        String?
  questions       String
  vocabularyHints String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  progress        ReadingProgress[]
}

model ReadingProgress {
  id          String   @id @default(cuid())
  userId      String?
  exerciseId  String
  answers     String?
  score       Int?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  exercise    ReadingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model VideoAssignment {
  id          String   @id @default(cuid())
  title       String
  youtubeUrl  String
  youtubeId   String
  description String?
  level       String   @default("B1")
  prompts     String?
  type        String   @default("video")
  topic       String?
  duration    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  summaries   VideoSummary[]
}

model VideoSummary {
  id           String   @id @default(cuid())
  userId       String?
  assignmentId String
  summary      String
  aiFeedback   String?
  aiScore      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignment   VideoAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model ConversationSession {
  id           String   @id @default(cuid())
  userId       String?
  topic        String
  scenario     String?
  level        String   @default("B1")
  systemPrompt String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String?
  role      String
  content   String
  context   String
  createdAt DateTime @default(now())
  session   ConversationSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model LearningStats {
  id               String   @id @default(cuid())
  userId           String?
  date             String
  vocabStudied     Int      @default(0)
  readingDone      Int      @default(0)
  videosWatched    Int      @default(0)
  conversationMins Int      @default(0)
  streak           Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, date])
}
